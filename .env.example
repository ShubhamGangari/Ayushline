# ====================================================================
# AYUSHLINE — ENVIRONMENT VARIABLES
# ====================================================================
# Copy this to `.env` for local dev, or set the same values in your
# hosting provider (Vercel/Netlify) before running `npm run build`.
#
# All `VITE_` vars are PUBLIC and ship to the browser. Do NOT put
# secret keys (Clerk Secret key / Supabase service_role key) here.

# 1. CLERK — auth (https://dashboard.clerk.com -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# 2. SUPABASE — database (https://supabase.com/dashboard -> Settings -> API)
#    Run supabase/schema.sql in the SQL Editor first to create tables + bucket.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. ADMIN — who gets access to /admin. Pick ONE method.
#    Method A: Clerk user ID(s), comma-separated.
# VITE_ADMIN_USER_IDS=user_2xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#    Method B: email(s), lowercase, comma-separated.
VITE_ADMIN_EMAILS=you@example.com
